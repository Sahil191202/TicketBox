# Copy to .env.production before `npm run build` for a real server build.
#
# Day 7 (nginx on EC2 public IP — before DNS):
#   VITE_API_URL=http://YOUR_EC2_PUBLIC_IP:4000
#
# Day 8 (Route 53 hostnames — still HTTP):
#   VITE_API_URL=http://api.yourdomain.com
#
# Day 9 (after certbot HTTPS):
#   VITE_API_URL=https://api.yourdomain.com
#
# Rebuild after every change — this value is baked into the JS bundle.

VITE_API_URL=https://api.yourdomain.com
