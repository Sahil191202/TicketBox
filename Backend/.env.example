# App
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:5173
# Optional comma-separated extras (Day 7+):
# CORS_ORIGINS=http://127.0.0.1:5173

# Production (Day 6–9 on EC2) — examples only; set on the server .env
# NODE_ENV=production
# API_PUBLIC_URL=http://YOUR_EC2_PUBLIC_IP:4000
# WEB_ORIGIN=http://YOUR_EC2_PUBLIC_IP:3000
# ADMIN_ORIGIN=http://YOUR_EC2_PUBLIC_IP
# After DNS + HTTPS (Day 8–9):
# API_PUBLIC_URL=https://api.yourdomain.com
# WEB_ORIGIN=https://yourdomain.com
# ADMIN_ORIGIN=https://app.yourdomain.com


# Database
DATABASE_URL=postgresql://appuser:password@localhost:5432/ticketbox

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Razorpay (test mode keys ONLY — live keys are forbidden)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=ticketbox-banners
S3_PUBLIC_BASE_URL=

# Logging
LOG_LEVEL=info

# Seed admin (used by knex seed only)
ADMIN_EMAIL=admin@ticketbox.local
ADMIN_PASSWORD=Admin@12345
